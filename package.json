{
  "name": "fcs_web_e2e",
  "private": true,
  "packageManager": "bun@1.4.5",
  "scripts": {
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:visual": "playwright test e2e/visual.spec.ts",
    "e2e:visual:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "e2e:responsive": "playwright test e2e/responsive.spec.ts",
    "lint:fmt": "cargo fmt --check",
    "lint:clippy": "cargo clippy --locked -- -D warnings",
    "check:rust": "bun run lint:fmt && bun run lint:clippy && cargo test --locked && cargo build --locked",
    "perf:build": "trunk build index.html --release",
    "perf:bundle": "bash scripts/check_bundle_sizes.sh",
    "perf:lighthouse": "lhci autorun --config=./lighthouserc.json",
    "perf:ci": "bun run perf:build && bun run perf:bundle && bun run perf:lighthouse"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1"
  }
}
